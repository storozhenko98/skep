<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Skep Rust dependency licenses</title>
  <style>
    body { font: 16px/1.5 system-ui, sans-serif; margin: 0 auto; max-width: 880px; padding: 32px; }
    a { color: currentColor; }
    pre { border: 1px solid #999; overflow: auto; padding: 16px; white-space: pre-wrap; }
  </style>
</head>
<body>
  <main>
    <h1>Skep Rust dependency licenses</h1>
    <p>Generated from the locked Cargo dependency graph with cargo-about.</p>
    <h2>License overview</h2>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
      {{/each}}
    </ul>
    <h2>License texts and packages</h2>
    {{#each licenses}}
    <section>
      {{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
      <h4 id="{{id}}-{{@index}}">Used by</h4>
      <ul>
        {{#each used_by}}
        <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
    {{/each}}
  </main>
</body>
</html>
